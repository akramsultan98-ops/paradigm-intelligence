# ---------------------------------------------------------------------------
# PARADIGM INTELLIGENCE - environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (required) --------------------------------------------------
POSTGRES_DB=paradigm
POSTGRES_USER=paradigm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: a full URL overrides the parts above.
# DATABASE_URL=postgresql+psycopg://paradigm:CHANGE_ME@127.0.0.1:5432/paradigm

# --- API access (required outside development) -----------------------------
# Shared secret for /api/v1, sent as the X-API-Key header or a bearer token.
# Empty means open access: allowed when APP_ENV=development, refused otherwise.
# Health probes are always open.
API_KEY=
CORS_ORIGINS=http://localhost:3000

# --- AI provider ----------------------------------------------------------
# anthropic  -> live Claude extraction (requires ANTHROPIC_API_KEY)
# rule_based -> deterministic keyword extractor, no network, no AI (dev/tests)
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_SECONDS=60

# --- Market scope ---------------------------------------------------------
TARGET_COUNTRY=EG
# Comma-separated and fully configurable.
SECTORS=Technology,Telecommunications,Oil & Gas,Energy,Banking,Fintech,FMCG,Automotive,Pharma,Healthcare,Real Estate,Construction,Engineering,Industrial,Manufacturing

# --- Top 50 ---------------------------------------------------------------
TOP_N=50
MIN_QUALIFYING_SCORE=70

# --- Scoring weights (must sum to 1.0; startup fails otherwise) -----------
WEIGHT_EVENT_PROBABILITY=0.35
WEIGHT_COMMERCIAL_VALUE=0.25
WEIGHT_CONTACT_QUALITY=0.20
WEIGHT_TIMING=0.10
WEIGHT_EVIDENCE=0.10

# --- Conservatism ---------------------------------------------------------
EVENT_PROBABILITY_EXPONENT=1.25
EVENT_PROBABILITY_CAP_UNCONFIRMED=95
EVIDENCE_CAP_BASE=55
EVIDENCE_CAP_SLOPE=0.45

# --- Contact damping ------------------------------------------------------
CONTACT_QUALITY_FLOOR=40
CONTACT_QUALITY_WEAK_MULTIPLIER=0.5
CONTACT_CORROBORATION_BONUS=3
CONTACT_CORROBORATION_MAX_BONUS=9

# --- Score decay ----------------------------------------------------------
DECAY_GRACE_DAYS=14
DECAY_TAU_DAYS=120
DECAY_FLOOR=0.20
MISSED_WINDOW_PENALTY=0.60
THIN_EVIDENCE_THRESHOLD=40
THIN_EVIDENCE_PENALTY=0.90

# --- Relevance filter (runs before AI extraction) -------------------------
RELEVANCE_ENABLED=true
RELEVANCE_MIN_CHARS=120
RELEVANCE_MIN_SCORE=20
RELEVANCE_MIN_BUSINESS_HITS=3
RELEVANCE_NOISE_HITS=3
RELEVANCE_NOISE_OVERRIDE_HITS=4

# --- Ingestion ------------------------------------------------------------
SOURCES_CONFIG=config/sources.json
# Which sources run, by key, comma-separated. Empty means none: config/sources.json
# ships every entry disabled and is mounted read-only in the container, so this is
# how a source is switched on. Setting it replaces the file's `enabled` flags
# entirely - exactly these keys run and everything else is off.
#
# Do not fill this in by hand from the registry. Probe first, so a source can only
# be enabled by demonstrating that it works. Probe from inside the container, whose
# networking is the one that matters, then write the value to this file on the host
# (compose reads the host's .env, not one inside the container):
#
#   docker compose exec -T api python -m app.cli enable-sources          # see verdicts
#   docker compose exec -T api python -m app.cli enable-sources --quiet >> .env
#   docker compose up -d api
#
# Without Docker, the CLI can edit this file directly:
#
#   python -m app.cli enable-sources --write-env .env
#
# An unknown key is rejected with the list of keys that do exist, rather than
# silently ingesting nothing. `status` reports it as sources_error, and ingest and
# check-sources refuse to run; the API keeps serving, since a bad ingestion setting
# is not a reason to take the Top 50 offline.
SOURCES_ENABLED=
INGEST_LOOKBACK_DAYS=30
INGEST_MAX_DOCS_PER_SOURCE=50
INGEST_HTTP_TIMEOUT=30
INGEST_DEFAULT_RATE_LIMIT_PER_MINUTE=20
INGEST_MAX_ATTEMPTS=3
INGEST_MAX_BACKOFF_SECONDS=30
INGEST_MAX_RESPONSE_BYTES=5000000

# --- Daily brief ----------------------------------------------------------
BRIEF_LOOKBACK_HOURS=24
BRIEF_TOP_NEW_LIMIT=10
BRIEF_TOP_CHANGED_LIMIT=10

# --- Background scheduler (off by default; cron is the alternative) --------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=6
SCHEDULER_INITIAL_DELAY_SECONDS=60

# --- Frontend (read by the Next.js server, never sent to the browser) -----
# API_BASE_URL=http://127.0.0.1:8000
